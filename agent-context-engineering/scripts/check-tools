#!/usr/bin/env bash
# Task 2.4 — verificación de disponibilidad del toolchain.
# Tools faltantes no bloquean operación básica (exit 1 pero informa).
MISSING=0
for tool in rg fd jq yq sg tokei probe; do
  if command -v "$tool" >/dev/null 2>&1; then
    printf "%-8s OK   %s\n" "$tool" "$(command -v "$tool")"
  else
    printf "%-8s MISS\n" "$tool"
    MISSING=1
  fi
done
exit $MISSING
