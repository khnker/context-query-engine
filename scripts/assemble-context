#!/usr/bin/env bash
# 4.x assemble-context — pipeline de ensamblado de contexto desde retrieval NDJSON
# Uso:
#   assemble-context [BUDGET] < results.ndjson
# BUDGET en tokens (default 8000; niveles tipicos 2000/8000/20000/30000)
# Pipeline: normalize -> filter -> deduplicate -> rank -> budget -> order
# Salida: NDJSON con "tier" (T1..T4) por linea, stats de budget en stderr.
# Exit: 0 si entraron lineas (aunque todas se filtren), 1 si stdin vacio o error.

set -uo pipefail

if ! command -v jq >/dev/null 2>&1; then
  echo "assemble-context: jq not found" >&2
  exit 1
fi

BUDGET="${1:-8000}"
case "$BUDGET" in
  ''|*[!0-9]*) BUDGET=8000 ;;
esac
FB="${2:-0}"   # fuse-flood-boost (A3): bonus score_final para evidencia adquirida
case "$FB" in
  ''|*[!0-9.]*) FB=0 ;;
esac

# stdin vacio -> exit 1
if ! IFS= read -r first_line; then
  echo "assemble-context: error: stdin vacio (sin lineas NDJSON)" >&2
  exit 1
fi

# reranker-fuse-alignment — peso del score del modelo en score_final.
# Con reranker activo (CF_MODEL_CMD) el score aprendido domina (0.5); sin modelo
# legacy 0.3 (exactness 0.35). Override explícito: CF_SCORE_WEIGHT.
if [ -n "${CF_SCORE_WEIGHT:-}" ]; then
  SW="$CF_SCORE_WEIGHT"
elif [ -n "${CF_MODEL_CMD:-}" ]; then
  SW="0.5"
else
  SW="0.3"
fi

TMP_IN="$(mktemp)"
TMP_OUT="$(mktemp)"
trap 'rm -f "$TMP_IN" "$TMP_OUT"' EXIT

{ printf '%s\n' "$first_line"; cat; } > "$TMP_IN"

# M2 (adversarial-mitigations): CF_INCLUDE_GENERATED=1 relaja bad_path (dist/build visibles
# para generated-code opt-in; por defecto siguen excluidos — política de contexto limpio)
BAD_PATH_LIST='["node_modules",".git","dist","build","coverage","vendor"]'
if [ "${CF_INCLUDE_GENERATED:-}" = "1" ]; then
  BAD_PATH_LIST='["node_modules",".git","coverage","vendor"]'
fi

# M3 (adversarial-mitigations) + strict-budget-default: budget duro POR DEFECTO
# (sin la cláusula path-cluster que permitía exceder — mo-26: 15836 vs 8000 =
# failure duro de correctness). Opt-out con CF_STRICT_BUDGET=0 (comportamiento legacy).
STRICT_FLAG=true
if [ "${CF_STRICT_BUDGET:-}" = "0" ]; then
  STRICT_FLAG=false
fi

# 07B (context selection submodular): CF_SELECTOR=marginal o CF_SELECTOR_RANKED_ONLY=1 →
# NO aplicar budget aqui; devolver el ranked completo para que el selector externo
# (engine/selector.js) elija el subconjunto por ganancia marginal. Cap a top-N
# candidatos por relevancia (CF_SELECTOR_TOP, default 200) para acotar fan-out.
NOBUDGET_FLAG=false
SELECTOR_TOP="${CF_SELECTOR_TOP:-200}"
if [ "${CF_SELECTOR:-}" = "marginal" ] || [ "${CF_SELECTOR_RANKED_ONLY:-}" = "1" ]; then
  NOBUDGET_FLAG=true
fi

if ! jq -s -c --argjson BUDGET "$BUDGET" --argjson BADPATH "$BAD_PATH_LIST" --argjson STRICT "$STRICT_FLAG" --argjson SW "$SW" --argjson NOBUDGET "$NOBUDGET_FLAG" --argjson TOP "$SELECTOR_TOP" '
  # ---- normalize ----
  def bad_path:
    all((.path | split("/"))[]; . as $s |
      ($BADPATH | index($s) | not));
  def exactness:
    if .match_type == "exact" then 1
    elif .match_type == "filename" then 0.8
    elif .match_type == "structural" then 0.7
    elif .match_type == "reference" then 0.6
    elif .match_type == "semantic" then 0.5
    elif .match_type == "test" then 0.4
    elif .match_type == "config" then 0.3
    else 0.5 end;
  def path_relevance:
    if (.match_type == "test" and ((.path | contains("tests")) or (.path | contains("spec")))) then 0.5
    elif (.match_type == "config" and (.path | contains("config"))) then 0.5
    else 0.3 end;
  def token_efficiency: 1 - ([.token_estimate, 400] | min) / 400;
  # 07A evidence model — jerarquía de evidencia (no todos los scores comparten espacio):
  #   tier0 determinista (exact/filename/structural) — hecho observado, SIEMPRE eligible
  #   tier1 lexical (reference/git) — evidencia derivada, SIEMPRE eligible
  #   tier2 semántico (semantic [reranker/bm25]) — belief, sujeto a umbral de score
  #   tier3 inferido/débil (test/config/otro) — sujeto a umbral
  def evidence_tier:
    if (.match_type == "exact" or .match_type == "filename" or .match_type == "structural") then 0
    elif (.match_type == "reference" or .match_type == "git") then 1
    elif (.match_type == "semantic") then 2
    else 3 end;
  def tier:
    if (.match_type == "exact" or .match_type == "filename") then 1
    elif (.match_type == "structural" or .match_type == "reference") then 2
    elif (.match_type == "semantic") then 3
    else 4 end;

  map(select((( .path        | type) == "string") and (.path        | length > 0)
             and ((.line_start | type) == "number")
             and ((.line_end   | type) == "number"))
      | .path |= (if startswith("./") then .[2:] else . end)
      | .score = (if ((.score | type) == "number") then .score else 0.5 end)
      | .token_estimate = (if ((.token_estimate | type) == "number")
                           then .token_estimate
                           else ((.line_end - .line_start + 1) * 5) end)
      | .source = (.source // "unknown")
      | .match_type = (.match_type // "semantic")
      | .reason = (.reason // "")
      | .symbol = (.symbol // null)
      | .language = (.language // null)
      | .evidence_tier = evidence_tier)
  # ---- filter (07A): la evidencia determinista/lexical no se puede destruir por score;
  # ----  solo tier2+ (belief) pasa por el umbral de eligibilidad ----
  | map(select(((evidence_tier <= 1) or (.score >= 0.2)) and (.token_estimate > 0) and bad_path))
  # ---- deduplicate: clave path:line_start:line_end, max score, sources acumuladas ----
  | group_by(.path, .line_start, .line_end)
  | map(. as $g | ($g | max_by(.score)) as $best
        | $best + { score: ($g | map(.score) | max), sources: [ $g[].source ] })
  # ---- rank: score_final multi-factor (SW = peso del score del modelo; sin
  # modelo legacy exactness 0.35/score 0.3; con reranker SW=0.5) ----
  | map(. + { score_final: ((1 - $SW - 0.2 - 0.15) * exactness + $SW * .score
                             + 0.2 * path_relevance + 0.15 * token_efficiency) })
  | sort_by(-.score_final)
  # ---- budget (07B): con NOBUDGET el selector externo aplica el budget submodular;
  # ---- si no, greedy legacy por score_final hasta BUDGET (strict por defecto) ----
  | . as $ranked
  | if $NOBUDGET then
      { stats: { budget: $BUDGET, selector_top: $TOP,
                 tokens_used: ($ranked | .[0:$TOP] | map(.token_estimate) | add),
                 kept: (($ranked | length) | if . < $TOP then . else $TOP end), dropped: 0 },
        items: ($ranked | .[0:$TOP]) }
    else
      (reduce $ranked[] as $c ({ kept: [], used: 0 };
        if (.used + $c.token_estimate <= $BUDGET) or (($STRICT | not) and (([.kept[].path] | index($c.path)) == null)) then
          .kept += [$c] | .used += ($c.token_estimate)
        else . end)
      | . as $res
      | { stats: { budget: $BUDGET, tokens_used: $res.used, kept: ($res.kept | length),
                   dropped: (($ranked | length) - ($res.kept | length)) },
          items: ($res.kept
                  | map(. + { tier: tier })
                  | sort_by(.tier, -.score_final)) })
    end
  | (.stats, .items[])
' "$TMP_IN" > "$TMP_OUT"; then
  echo "assemble-context: error: jq fallo procesando input" >&2
  exit 1
fi

# primera linea = stats -> stderr; resto = NDJSON -> stdout
IFS= read -r stats < "$TMP_OUT"
printf '%s\n' "$stats" >&2
sed -n '2,$p' "$TMP_OUT"
