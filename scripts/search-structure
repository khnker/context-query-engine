#!/usr/bin/env bash
# 3.3 search-structure — wrapper ast-grep
# Uso: search-structure [-d DIR] PATTERN
# Exit: 0 OK, 2 tool-missing (ast-grep/sg), 1 error de uso

set -uo pipefail

if command -v ast-grep >/dev/null 2>&1; then
  BIN="ast-grep"
elif command -v sg >/dev/null 2>&1; then
  BIN="sg"
else
  echo "search-structure: ast-grep/sg not found" >&2
  exit 2
fi

DIR="."
while getopts ":d:" opt; do
  case "$opt" in
    d) DIR="$OPTARG" ;;
    *) echo "search-structure: opcion invalida -$OPTARG" >&2; exit 1 ;;
  esac
done
shift $((OPTIND-1))

if [ $# -lt 1 ]; then
  echo "search-structure: falta PATTERN (uso: search-structure [-d DIR] PATTERN)" >&2
  exit 1
fi

PATTERN="$1"

$BIN run -p "$PATTERN" "$DIR"
