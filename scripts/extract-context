#!/usr/bin/env bash
# 3.4 extract-context — imprime archivo con numeracion de lineas
# Uso: extract-context FILE [START_LINE] [END_LINE]
#   Sin range: archivo completo. Con START: desde START. Con ambos: rango.
# Exit: 0 OK, 1 error de uso / archivo inexistente / START > END

set -uo pipefail

source "$(dirname "$0")/env.sh"

if [ $# -lt 1 ]; then
  echo "extract-context: falta FILE (uso: extract-context FILE [START_LINE] [END_LINE])" >&2
  exit 1
fi

FILE="$1"
START="${2:-1}"
END="${3:-}"

if [ ! -f "$FILE" ]; then
  echo "extract-context: archivo no existe: $FILE" >&2
  exit 1
fi

if ! [[ "$START" =~ ^[0-9]+$ ]] || { [ -n "$END" ] && ! [[ "$END" =~ ^[0-9]+$ ]]; }; then
  echo "extract-context: START_LINE/END_LINE deben ser numeros" >&2
  exit 1
fi

if [ -n "$END" ] && [ "$START" -gt "$END" ]; then
  echo "extract-context: START_LINE ($START) > END_LINE ($END)" >&2
  exit 1
fi

awk -v start="$START" -v end="$END" 'NR >= start && (end == "" || NR <= end) { printf "%d: %s\n", NR, $0 }' "$FILE"
